# Copy to .env for local development (Bun loads .env automatically).
# Names are case-sensitive; invalid or missing values stop the app at startup with a clear message.

# Port and interface to listen on
PORT=3000
HOST=0.0.0.0

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# json | pretty (default: json when NODE_ENV=production, pretty otherwise)
# LOG_FORMAT=pretty

# postgres://user:pass@host:5432/db, mysql://…, sqlite://data/app.sqlite
# Default: sqlite://:memory: (always migrated on start; data is lost on restart)
# DATABASE_URL=sqlite://data/app.sqlite

# Apply pending migrations when the server starts (default: false; prefer `bun hydrate db:migrate` in deploys)
# MIGRATE_ON_START=false

# Client IP behind proxies: false (default), a hop count such as 1, or proxy CIDRs such as 10.0.0.0/8
# TRUST_PROXY=false

# --- Features (added with `bun hydrate add`; `bun hydrate doctor` lists what is missing) ---

# Sessions (auth:sessions): sign out after inactivity / this long after login regardless
# SESSION_IDLE_TIMEOUT=30m
# SESSION_ABSOLUTE_TIMEOUT=7d

# Metrics (metrics): scrapers send `Authorization: Bearer <token>`; without it, production does not serve /metrics
# METRICS_TOKEN=

# CORS (security:cors): browser apps on other origins allowed to call the API with cookies
# CORS_ORIGINS=https://app.example.com

# Global rate limit per client IP (rate-limit)
# RATE_LIMIT_PER_MINUTE=300

# Only with the corresponding features:
# JWT_SECRET=             # auth:jwt, at least 32 random characters
# OIDC_ISSUER= OIDC_AUDIENCE=   # auth:oidc

# Largest request body the server accepts (uploads included); routes can only lower it with bodyLimit()
# MAX_BODY_SIZE=10mb

# --- v0.4: jobs, events, storage, fan-out ---

# Redis (the redis feature; the reference app uses it for chat across instances when set)
# REDIS_URL=redis://127.0.0.1:6379
# REDIS_PREFIX=bun-hydrate:

# Worker process (jobs:*): `bun hydrate worker`, or `bun dist/worker.js` in production
# WORKER_CONCURRENCY=10
# WORKER_QUEUES=default,mail      # default: every queue its jobs use
# WORKER_PORT=3100                # /health, /ready, /metrics; default: no port

# File storage on this server (storage:local); the signing key is required in production
# STORAGE_ROOT=data/storage
# STORAGE_SIGNING_KEY=            # at least 32 random characters, e.g. `openssl rand -base64 48`

# File storage in S3 or an S3-compatible store (storage:s3)
# S3_BUCKET= S3_REGION= S3_ENDPOINT= S3_ACCESS_KEY_ID= S3_SECRET_ACCESS_KEY=

# Where the reference app's LogMailer appends mail (JSON lines)
# OUTBOX_PATH=data/outbox.jsonl

# Any variable can instead be read from a file (Docker/Kubernetes secrets): e.g. METRICS_TOKEN_FILE=/run/secrets/metrics
