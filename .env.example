# Copy to .env for local development (Bun loads .env automatically).
# Names are case-sensitive; invalid or missing values stop the app at startup with a clear message.

# Port and interface to listen on
PORT=3000
HOST=0.0.0.0

# trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# json | pretty (default: json when NODE_ENV=production, pretty otherwise)
# LOG_FORMAT=pretty

# postgres://user:pass@host:5432/db, mysql://…, sqlite://data/app.sqlite
# Default: sqlite://:memory: (always migrated on start; data is lost on restart)
# DATABASE_URL=sqlite://data/app.sqlite

# Apply pending migrations when the server starts (default: false; prefer `bun hydrate db:migrate` in deploys)
# MIGRATE_ON_START=false
