# Caddy in front of the built app: HTTPS, compression, and one public port.
#
#   sudo cp docs/deploy/Caddyfile /etc/caddy/Caddyfile   # replace example.com with your domain
#   sudo systemctl reload caddy
#
# Caddy takes ports 80 and 443, so the app listens on 127.0.0.1:3000 behind it. deploy.sh
# starts it on PORT=80 today: set PORT=3000 and HOST=127.0.0.1 there (or in /opt/app/.env),
# and TRUST_PROXY=1 so ctx.ip and ctx.protocol are the client's, not Caddy's (rate limits,
# secure cookies and logs depend on them).
#
# Bun already serves /assets/* (hashed JS and CSS from `hydrate build`) with the right
# content types, `cache-control: public, max-age=31536000, immutable` and nosniff, and Caddy
# passes those through. Bun does not compress, so `encode` does.

example.com {
	encode zstd gzip

	# Optional: serve the hashed assets from disk without going through Bun. The URL maps
	# straight onto the release: /assets/x.css is dist/public/assets/x.css. Bun's headers no
	# longer apply here, so they are set below. Point `root` at the "current" symlink that
	# deploy.sh re-points, never at one release. Only /assets: signed /files URLs from
	# storage:local and everything else must still reach the app.
	#
	# handle /assets/* {
	# 	root * /opt/app/current/dist/public
	# 	header Cache-Control "public, max-age=31536000, immutable"
	# 	header X-Content-Type-Options nosniff
	# 	file_server
	# }

	handle {
		reverse_proxy 127.0.0.1:3000
	}
}
