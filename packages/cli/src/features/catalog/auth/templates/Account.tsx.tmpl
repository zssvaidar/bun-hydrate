import { useState } from "react";
import { useAuth } from "../../auth";

export function Account() {
  const { status, user, logout, authFetch } = useAuth();
  const [pending, setPending] = useState(false);

  if (status !== "signed-in") {
    return (
      <main>
        <p>
          You are signed out. <a href="/login">Sign in</a>
        </p>
      </main>
    );
  }

  async function signOutEverywhere() {
    setPending(true);
    await authFetch("/api/v1/auth/logout-everywhere", { method: "POST" });
    await logout();
  }

  return (
    <main>
      <h1>Your account</h1>
      <p>
        Signed in as <strong>{user?.email}</strong>
      </p>
      <button type="button" onClick={() => void logout()} disabled={pending}>
        Sign out
      </button>
      <button type="button" onClick={() => void signOutEverywhere()} disabled={pending}>
        Sign out everywhere
      </button>
    </main>
  );
}
