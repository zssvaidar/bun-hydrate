import { afterEach, beforeEach, expect, test } from "bun:test";
import { join } from "node:path";
import { App, createLogger } from "@bun-hydrate/core";
import { Database } from "@bun-hydrate/database";
import { Container } from "@bun-hydrate/di";
import { defineJob, type Queue } from "@bun-hydrate/queue";
import { createTestDatabase } from "@bun-hydrate/testing/database";
import { schema } from "@bun-hydrate/validation";
import { installRedis } from "../platform/redis";
import { AppQueue, installJobs } from "./queue";

const MIGRATIONS = join(import.meta.dir, "../../migrations");
const ping = defineJob({ name: "queue-test-ping", payload: schema.object({}), handle: () => {} });

let app: App;
let db: Database;
let queue: Queue;

// Runs when a Redis for tests is available, e.g. TEST_REDIS_URL=redis://127.0.0.1:6379
const withRedis = test.if(Boolean(process.env.TEST_REDIS_URL));

beforeEach(async () => {
  process.env.REDIS_URL = process.env.TEST_REDIS_URL ?? "redis://127.0.0.1:6379";
  process.env.REDIS_PREFIX = `queue-test-${crypto.randomUUID()}:`;
  app = new App({ logger: createLogger({ level: "silent" }), health: false });
  db = await createTestDatabase({ migrations: MIGRATIONS });
  const container = new Container().value(Database, db);
  installRedis(app, container);
  installJobs(container);
  queue = container.get(AppQueue);
  await app.run({ handleSignals: false });
});

afterEach(async () => {
  await app.stop();
  await db.close();
});

withRedis("a job dispatched in a transaction is enqueued when it commits, never on rollback", async () => {
  await db.transaction(async () => {
    await queue.dispatch(ping, {});
    throw new Error("roll back");
  }).catch(() => {});
  expect(await queue.adapter.counts()).toEqual({});

  await db.transaction(() => queue.dispatch(ping, {}));
  expect((await queue.adapter.counts()).default?.pending).toBe(1);
});
