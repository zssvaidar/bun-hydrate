import { afterEach, beforeEach, expect, test } from "bun:test";
import { Container } from "@bun-hydrate/di";
import { startFakeS3, type FakeS3 } from "@bun-hydrate/testing/s3";
import { AppStorage, installStorage } from "./storage";

let s3: FakeS3;

beforeEach(() => {
  s3 = startFakeS3();
  process.env.S3_BUCKET = s3.bucket;
  process.env.S3_REGION = s3.region;
  process.env.S3_ENDPOINT = s3.endpoint;
  process.env.S3_ACCESS_KEY_ID = s3.accessKeyId;
  process.env.S3_SECRET_ACCESS_KEY = s3.secretAccessKey;
});

afterEach(() => s3.stop());

test("stores files in the bucket and presigns URLs for them", async () => {
  const container = new Container();
  installStorage(container);
  const storage = container.get(AppStorage);

  await storage.put("notes/hello.txt", "hello", { contentType: "text/plain" });
  expect(await (await storage.get("notes/hello.txt"))!.text()).toBe("hello");
  const url = await storage.signedUrl("notes/hello.txt", { expiresIn: "5m" });
  expect(await (await fetch(url)).text()).toBe("hello");
});
