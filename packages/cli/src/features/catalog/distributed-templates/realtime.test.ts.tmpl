import { expect, test } from "bun:test";
import { App, createLogger } from "@bun-hydrate/core";
import { Container } from "@bun-hydrate/di";
import { installRealtime } from "./realtime";
import { installRedis } from "./redis";

// Runs when a Redis for tests is available, e.g. TEST_REDIS_URL=redis://127.0.0.1:6379
test.if(Boolean(process.env.TEST_REDIS_URL))("a message published on one instance reaches a client of another", async () => {
  process.env.REDIS_URL = process.env.TEST_REDIS_URL;
  process.env.REDIS_PREFIX = `realtime-test-${crypto.randomUUID()}:`;
  const instances = [0, 1].map(() => {
    const app = new App({ logger: createLogger({ level: "silent" }), health: false });
    const container = new Container();
    installRedis(app, container);
    installRealtime(app, container);
    app.websocket("/ws", {
      open(ws) {
        ws.subscribe("news");
      },
    });
    return app;
  });
  const [, b] = await Promise.all(instances.map((app) => app.listen({ port: 0, handleSignals: false })));

  const client = new WebSocket(`ws://127.0.0.1:${b!.port}/ws`);
  await new Promise((resolve) => client.addEventListener("open", resolve));
  const received = new Promise((resolve) => client.addEventListener("message", (event) => resolve(event.data)));
  await Bun.sleep(50); // the server subscribes the socket in open()
  await instances[0]!.publish("news", "hello from A");
  expect(await received).toBe("hello from A");

  client.close();
  await Promise.all(instances.map((app) => app.stop()));
});
